[Desktop Entry]
Type=Application
Name=Shotnote
Comment=Take a screenshot and annotate it
Exec=shotnote %f
Icon=applets-screenshooter
Terminal=false
Categories=Graphics;Utility;
MimeType=image/png;image/jpeg;image/webp;image/gif;image/bmp;image/tiff;
StartupNotify=true
StartupWMClass=dev.local.Shotnote
