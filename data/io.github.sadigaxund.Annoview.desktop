[Desktop Entry]
Type=Application
Name=Annoview
Comment=Take a screenshot and annotate it
Exec=annoview %f
Icon=io.github.sadigaxund.Annoview
Terminal=false
Categories=Graphics;Viewer;
MimeType=image/png;image/jpeg;image/webp;image/gif;image/bmp;image/tiff;
StartupNotify=true
StartupWMClass=io.github.sadigaxund.Annoview
